{
  "name": "rb-tracker-local",
  "productName": "RB Tracker",
  "version": "1.1.0",
  "description": "Offline tracker for rings sent to the manufacturer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "tauri dev",
    "test": "vitest run",
    "test:tracking": "node --test tracking/worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "setup:tracking": "npm install --prefix tracking --no-audit --no-fund",
    "prepare:tracking": "npm run setup:tracking && node tracking/prepare.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
